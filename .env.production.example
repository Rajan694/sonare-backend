# Production settings for docker-compose.prod.yml. Copy to .env.production (never commit
# it) and replace every CHANGE_ME. The backend refuses to start in production with the
# development JWT secret, without RESEND_API_KEY, or with a non-https APP_URL.

NODE_ENV=production
PORT=3010
LOG_LEVEL=info

# ---- Database and cache (the postgres and redis services in the compose file) ----
# POSTGRES_PASSWORD is read by the postgres container; keep it equal to the password in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://sonare:CHANGE_ME@postgres:5432/sonare
REDIS_URL=redis://redis:6379/1

# ---- Piped ----
# Piped runs from sonare-piped-backend with its own compose file, on the same host.
# host.docker.internal is the host as seen from the backend container (see extra_hosts).
# Piped's compose publishes 8090/8091 on 127.0.0.1, which containers cannot reach: publish
# them on the Docker bridge address instead (e.g. "172.17.0.1:8090:8080"), or give Piped
# its own hostname behind the reverse proxy and use that here.
# The backend also relays the media URLs Piped hands out, so Piped's proxy URL
# (PIPED_PROXY_URL in sonare-piped-backend/.env) must be reachable from this container too.
PIPED_API_URL=http://host.docker.internal:8090
# Piped at home behind Tailscale Funnel (sonare-piped-backend/funnel.sh): the Funnel URL here,
# and the same PIPED_KEY as in sonare-piped-backend/.env. Leave PIPED_KEY empty for a local Piped.
# PIPED_API_URL=https://<machine>.<tailnet>.ts.net
# PIPED_KEY=

# ---- Lyrics ----
LRCLIB_BASE=https://lrclib.net
LRCLIB_USER_AGENT=Sonare/1.0 (https://sonare.vip)

# ---- Security ----
# At least 32 characters. Generate one with: openssl rand -hex 48
JWT_SECRET=
# The web app, and the desktop app's fixed Neutralino port.
CORS_ORIGINS=https://sonare.vip,http://localhost:47823
# One reverse proxy in front of the backend.
TRUST_PROXY=1

# ---- Email (Resend's HTTP API) ----
# The sending domain (sonare.vip) must be verified in Resend first.
RESEND_API_KEY=CHANGE_ME
MAIL_FROM="Sonare <no-reply@sonare.vip>"
# Links in verification and password-reset emails point here.
APP_URL=https://sonare.vip

# ---- App builds ----
# /releases serves the latest GitHub release of this repo. A token (no scopes needed for a
# public repo) lifts GitHub's 60 requests an hour per IP.
RELEASES_REPO=Rajan694/sonare
# GITHUB_TOKEN=

# AI features. A provider with a key is added to the admin panel's AI page on the first start;
# manage, test and disable providers there after that. Base URLs and models have defaults.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=openrouter/free
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# GEMINI_MODEL=gemini-3.1-flash-lite
