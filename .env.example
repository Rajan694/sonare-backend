PORT=3010
DATABASE_URL=postgres://postgres:yourpassword@127.0.0.1:5432/sonare
REDIS_URL=redis://127.0.0.1:6379/1
PIPED_API_URL=http://localhost:8090
PIPED_PROXY_URL=http://localhost:8091
LRCLIB_BASE=https://lrclib.net
LRCLIB_USER_AGENT=Sonare/1.0
JWT_SECRET=your_secret_here
GENIUS_CLIENT_ACCESS_TOKEN=
# Comma-separated list of allowed CORS origins (exact matches, e.g. https://sonare.example.com,https://app.example.com)
# Production: CORS_ORIGINS=https://sonare.dev
CORS_ORIGINS=
# Where the admin page reads the Piped build settings from (default ../sonare-piped-backend)
# PIPED_BACKEND_DIR=

# SMTP configuration for sending emails
# Development (Mailpit): SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_SECURE=false, SMTP_USER=, SMTP_PASS=
# Production (Resend): SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=resend, SMTP_PASS=<Resend API key>
# The sending domain must be verified in Resend first.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sonare <no-reply@sonare.dev>"
APP_URL=http://localhost:5183
