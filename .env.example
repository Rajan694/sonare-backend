PORT=3010
DATABASE_URL=postgres://postgres:yourpassword@127.0.0.1:5432/sonare
REDIS_URL=redis://127.0.0.1:6379/1
PIPED_API_URL=http://localhost:8090
# Only for a Piped reached through Tailscale Funnel: the key its gate expects (sonare-piped-backend/.env).
# PIPED_KEY=
# Piped on this machine with Funnel on: its stream urls name the Funnel address; fetch them from
# the local proxy instead (this machine may not even resolve *.ts.net).
# PIPED_LOCAL_PROXY_URL=http://localhost:8091
LRCLIB_BASE=https://lrclib.net
LRCLIB_USER_AGENT=Sonare/1.0
JWT_SECRET=your_secret_here
# Comma-separated list of allowed CORS origins (exact matches, e.g. https://sonare.example.com,https://app.example.com)
# Production: CORS_ORIGINS=https://sonare.vip
CORS_ORIGINS=

# Email. With RESEND_API_KEY set, mail goes out through Resend's HTTP API (production, or to
# get real mail while developing; the sending domain must be verified in Resend first).
# Without it, mail goes to SMTP: Mailpit in development, its inbox at http://localhost:8025.
# RESEND_API_KEY=placeholder_api_key
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sonare <no-reply@sonare.vip>"
APP_URL=http://localhost:5183

# Behind a reverse proxy (nginx, Caddy, a load balancer) set the hop count so rate limits
# see the client IP instead of the proxy's: TRUST_PROXY=1
# TRUST_PROXY=

# Log level: fatal, error, warn, info, debug, trace or silent (default info).
# Logs are pretty-printed when NODE_ENV=development and JSON lines otherwise.
LOG_LEVEL=info

# App builds: /releases serves the latest GitHub release of RELEASES_REPO (default Rajan694/sonare).
# GITHUB_TOKEN lifts GitHub's 60 requests an hour per IP.
# RELEASES_REPO=Rajan694/sonare
# GITHUB_TOKEN=
