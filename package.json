{
  "name": "sonare-backend",
  "version": "1.0.0",
  "description": "Sonare native API — Express + TypeScript over a private Piped upstream",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:create": "tsx src/db/create.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^10.2.0",
    "pino": "^9.0.0",
    "pino-http": "^9.0.0",
    "postgres": "^3.4.9",
    "undici": "^6.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@types/pino": "^7.0.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}
